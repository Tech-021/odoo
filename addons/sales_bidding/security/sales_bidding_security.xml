<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sales Bidding Privilege -->
    <record id="sales_bidding_privilege" model="res.groups.privilege">
        <field name="name">Sales Bidding</field>
        <field name="sequence">10</field>
    </record>

    <!-- Sales Bidding User -->
    <record id="group_sales_bidding_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="sales_bidding.sales_bidding_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Sales Bidding Manager -->
    <record id="group_sales_bidding_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="sales_bidding.sales_bidding_privilege"/>
        <field name="implied_ids" eval="[(4, ref('sales_bidding.group_sales_bidding_user'))]"/>
    </record>

    <!-- User: Own Bids Only -->
    <record id="rule_sales_bid_user_own" model="ir.rule">
        <field name="name">Sales Bidding User: Own Bids</field>
        <field name="model_id" ref="model_sales_bid"/>
        <field name="groups" eval="[(4, ref('sales_bidding.group_sales_bidding_user'))]"/>
        <field name="domain_force">['|', ('salesperson_id', '=', user.id), '&amp;', ('platform', '=', 'freelancer'), ('salesperson_id', '=', False)]</field>
    </record>

    <!-- Manager: All Bids -->
    <record id="rule_sales_bid_manager_all" model="ir.rule">
        <field name="name">Sales Bidding Manager: All Bids</field>
        <field name="model_id" ref="model_sales_bid"/>
        <field name="groups" eval="[(4, ref('sales_bidding.group_sales_bidding_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
