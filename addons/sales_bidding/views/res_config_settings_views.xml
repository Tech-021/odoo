<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sales.bidding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app
                    string="Sales Bidding"
                    name="sales_bidding"
                    groups="sales_bidding.group_sales_bidding_manager"
                >
                    <block title="Bidding Configuration">

                        <setting
                            string="Daily Bid Target"
                            help="Default number of bids a salesperson should submit per day."
                        >
                            <field name="daily_bid_target"/>
                        </setting>

                        <block title="Freelancer Integration">
                            <setting string="Enabled">
                                <field name="freelancer_enabled"/>
                            </setting>
                            <setting string="Client ID">
                                <field name="freelancer_client_id"/>
                            </setting>
                            <setting string="Client Secret">
                                <field name="freelancer_client_secret" password="True"/>
                            </setting>
                            <setting string="Access Token">
                                <field name="freelancer_access_token" password="True"/>
                            </setting>
                            <setting string="Refresh Token">
                                <field name="freelancer_refresh_token" password="True"/>
                            </setting>
                            <setting string="Freelancer User ID">
                                <field name="freelancer_user_id"/>
                            </setting>
                            <setting string="Odoo User (Reference)"
                                     help="Informational only; imported bids remain unassigned until claimed.">
                                <field name="freelancer_odoo_user_id"/>
                            </setting>
                            <setting string="Initial Sync Days">
                                <field name="freelancer_initial_sync_days"/>
                            </setting>
                            <button name="action_sync_freelancer_bids"
                                    string="Sync Freelancer Bids"
                                    type="object"
                                    class="btn-primary"/>
                        </block>

                    </block>
                </app>

            </xpath>

        </field>
    </record>

</odoo>
